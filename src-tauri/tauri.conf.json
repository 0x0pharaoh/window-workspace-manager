{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Workset",
  "version": "0.1.0",
  "identifier": "com.workset.app",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Workset",
        "width": 1240,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "iconPath": "icons/32x32.png",
      "iconAsTemplate": true,
      "showMenuOnLeftClick": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "category": "Utility",
    "shortDescription": "Launch and arrange groups of Windows apps as reusable workspaces.",
    "longDescription": "Workset lets you save, launch and arrange groups of applications across multiple monitors.",
    "nsis": {
      "displayLanguageSelector": false
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256"
    }
  }
}
